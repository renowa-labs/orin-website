# Brevo SMTP — use the same delivery account as the Renowa Labs web site.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# CONTACT_FROM_EMAIL must be a sender or domain verified in Brevo.
CONTACT_FROM_EMAIL=website@renowa-labs.com
CONTACT_FROM_NAME=Orin Website
CONTACT_TO_EMAIL=info@renowa-labs.com

# Cloudflare Turnstile — keep the secret server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
